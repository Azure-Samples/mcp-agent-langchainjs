{
  "name": "mcp-agent-langchainjs",
  "description": "Serverless AI agent using LangChain.js and Model Context Protocol (MCP) integration to order burgers from a burger restaurant.",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "run-on-output -n 'ready' -p 'burger.*lock lease,agent.*lock lease' concurrently \"npm:start:*\" --kill-others",
    "start:burger": "npm run start --workspace=burger-webapp",
    "start:mcp": "npm run start --workspace=burger-mcp -- --local",
    "_start:beer": "npm run start --workspace=beer-mcp",
    "start:agent": "npm run start --workspace=agent-webapp",
    "ready": "echo '\n🚀 All services ready 🚀\n\n- Agent webapp  : http://localhost:4280\n- Burger webapp : http://localhost:5173\n- Burger MCP    : http://localhost:3000/mcp\n'",
    "build": "npm run build --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present",
    "env": "node env.js",
    "lint": "xo",
    "lint:fix": "xo --fix",
    "format": "prettier --list-different --write ."
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Azure-Samples/mcp-agent-langchainjs.git"
  },
  "homepage": "https://github.com/Azure-Samples/mcp-agent-langchainjs",
  "bugs": {
    "url": "https://github.com/Azure-Samples/mcp-agent-langchainjs/issues"
  },
  "keywords": [
    "langchainjs",
    "agent",
    "assistant",
    "serverless",
    "typescript",
    "azure",
    "azure-functions",
    "azure-static-web-apps",
    "hamburger",
    "mcp",
    "model-context-protocol"
  ],
  "author": "Microsoft",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "concurrently": "^10",
    "dotenv": "^17.4.2",
    "prettier": "^3",
    "rimraf": "^6",
    "run-on-output": "^1.0.1",
    "typescript": "^6",
    "xo": "^3"
  },
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "xo": [
    {
      "ignores": [
        "**/*.genai.mjs",
        "**/*.genai.js",
        "**/vite.config.ts",
        "**/slides/**/*.*",
        "packages/beer-mcp/scripts/*.ts",
        "**/*.html",
        "**/*.md"
      ]
    },
    {
      "files": [
        "**/*.{js,cjs,mjs,jsx,ts,cts,mts,tsx}"
      ],
      "space": true,
      "semicolon": true,
      "prettier": "compat",
      "rules": {
        "unicorn/no-abusive-eslint-disable": "off",
        "@typescript-eslint/triple-slash-reference": "off",
        "@typescript-eslint/naming-convention": "off",
        "@typescript-eslint/consistent-type-definitions": "off",
        "@typescript-eslint/member-ordering": "off",
        "@typescript-eslint/no-unsafe-assignment": "off",
        "@typescript-eslint/prefer-nullish-coalescing": "off",
        "@typescript-eslint/no-unsafe-return": "off",
        "@typescript-eslint/no-unsafe-argument": "off",
        "@typescript-eslint/consistent-type-imports": "off",
        "@typescript-eslint/no-empty-function": "off",
        "@typescript-eslint/no-floating-promises": "off",
        "@typescript-eslint/ban-types": "off",
        "@typescript-eslint/no-restricted-types": "off",
        "@typescript-eslint/switch-exhaustiveness-check": "off",
        "@typescript-eslint/no-unsafe-call": "off",
        "@typescript-eslint/no-unsafe-member-access": "off",
        "@typescript-eslint/no-unsafe-type-assertion": "off",
        "@typescript-eslint/strict-void-return": "off",
        "@typescript-eslint/no-dynamic-delete": "off",
        "@stylistic/curly-newline": "off",
        "@typescript-eslint/dot-notation": "off",
        "@typescript-eslint/no-base-to-string": "off",
        "@typescript-eslint/restrict-template-expressions": "off",
        "import-x/no-unassigned-import": "off",
        "import/extensions": "off",
        "n/prefer-global/process": "off",
        "no-new-func": "off",
        "capitalized-comments": "off",
        "unicorn/no-process-exit": "off",
        "unicorn/prefer-add-event-listener": "off",
        "unicorn/prefer-switch": "off",
        "unicorn/prefer-global-this": "off",
        "unicorn/prefer-module": "off",
        "unicorn/no-new-array": "off",
        "unicorn/no-array-callback-reference": "off",
        "curly": "off",
        "arrow-body-style": "off",
        "@typescript-eslint/strict-boolean-expressions": "off",
        "@typescript-eslint/no-unnecessary-type-assertion": "off",
        "@typescript-eslint/no-shadow": "off",
        "@stylistic/quotes": "off",
        "@stylistic/no-mixed-operators": "off",
        "jsdoc/require-asterisk-prefix": "off",
        "jsdoc/no-multi-asterisks": "off",
        "jsdoc/check-tag-names": "off",
        "jsdoc/informative-docs": "off",
        "regexp/prefer-named-capture-group": "off",
        "regexp/sort-character-class-elements": "off",
        "regexp/prefer-regexp-exec": "off",
        "regexp/no-super-linear-move": "off",
        "unicorn/consistent-class-member-order": "off",
        "unicorn/max-nested-calls": "off",
        "unicorn/class-reference-in-static-methods": "off",
        "unicorn/no-top-level-side-effects": "off",
        "unicorn/prefer-unicode-code-point-escapes": "off",
        "unicorn/no-declarations-before-early-exit": "off",
        "unicorn/no-break-in-nested-loop": "off",
        "unicorn/prefer-url-href": "off",
        "unicorn/prefer-object-iterable-methods": "off",
        "unicorn/prefer-location-assign": "off",
        "unicorn/prefer-iterator-to-array": "off",
        "unicorn/no-computed-property-existence-check": "off",
        "unicorn/require-css-escape": "off",
        "unicorn/prefer-ternary": "off",
        "unicorn/prefer-split-limit": "off",
        "unicorn/prefer-number-is-safe-integer": "off",
        "unicorn/prefer-number-coercion": "off",
        "unicorn/prefer-includes-over-repeated-comparisons": "off",
        "unicorn/prefer-else-if": "off",
        "unicorn/prefer-early-return": "off",
        "unicorn/no-useless-fallback-in-spread": "off",
        "unicorn/no-unsafe-string-replacement": "off",
        "unicorn/no-non-function-verb-prefix": "off",
        "unicorn/no-negated-array-predicate": "off",
        "unicorn/prefer-uint8array-base64": "off",
        "unicorn/prevent-abbreviations": [
          "error",
          {
            "allowList": {
              "combineDocsChain": true,
              "env": true,
              "Db": true,
              "db": true,
              "auth": true,
              "args": true,
              "Args": true,
              "arg": true,
              "i": true
            }
          }
        ]
      }
    },
    {
      "files": [
        "**/*.{js,cjs,mjs,jsx,ts,cts,mts,tsx}"
      ],
      "rules": {
        "curly": "off",
        "arrow-body-style": "off",
        "@stylistic/quotes": "off",
        "@stylistic/no-mixed-operators": "off"
      }
    }
  ],
  "prettier": {
    "tabWidth": 2,
    "semi": true,
    "singleQuote": true,
    "printWidth": 120,
    "bracketSpacing": true
  }
}
